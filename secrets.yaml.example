# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
ap_password: "YourFallbackAPPassword"

ota_password: "YourOTAPassword"

# MQTT broker — local Mosquitto or remote host
mqtt_broker: "192.168.x.x"
mqtt_port: "1883"

# Leave blank for anonymous (local Mosquitto default)
# mqtt_username: ""
# mqtt_password: ""
